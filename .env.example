# Marqq-test local env (copy to .env)
# Never commit real secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only — required for workspace/GTM/outreach/agent persistence (never VITE_)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: 1=force on, 0=force off; default on when service role is set
USE_SUPABASE_PERSISTENCE=
VITE_GROQ_API_KEY=

# Public site URL (Composio OAuth callback = $APP_URL/onboarding)
# Use a clean URL only — do NOT paste BACKEND_PORT on the same line.
APP_URL=https://marqq3-production.up.railway.app

COMPOSIO_API_KEY=
